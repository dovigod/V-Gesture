{
  "name": "vgesture-engine",
  "type": "module",
  "collaborators": [
    "Dovigod <dovimccalister@gmail.com>"
  ],
  "description": "Rust based gesture handler engine",
  "version": "0.0.0",
  "license": "MIT/Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dovigod/V-Gesture"
  },
  "exports": {
